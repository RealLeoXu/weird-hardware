						"gencode" : "History history_1(0);\nHistory history_2(0);\nHistory history_3(0);\nHistory history_4(0);\nmin_5 = max(in2, 0);\nmin_6 = max(in3, 0.01);\nomega = ((min_5 * twopi)) / samplerate;\nsn = sin(omega);\ncs = cos(omega);\nalpha = ((sn * 0.5)) / min_6;\nb0 = 1 / ((1 + alpha));\na0 = alpha * b0;\na2 = (-alpha) * b0;\nb1 = ((-2 * cs)) * b0;\nb2 = ((1 - alpha)) * b0;\nexpr_7 = a0;\nexpr_8 = 0;\nexpr_9 = a2;\nexpr_10 = b1;\nexpr_11 = b2;\nmul_12 = in1 * expr_7;\nmul_13 = history_3 * expr_8;\nmul_14 = history_2 * expr_9;\nmul_15 = history_1 * expr_11;\nmul_16 = history_4 * expr_10;\nsub_17 = ((((mul_14 + mul_13)) + mul_12)) - ((mul_16 + mul_15));\ngen_18 = sub_17;\nhistory_1_next_19 = fixdenorm(history_4);\nhistory_2_next_20 = fixdenorm(history_3);\nhistory_3_next_21 = fixdenorm(in1);\nhistory_4_next_22 = fixdenorm(sub_17);\nout1 = gen_18;\nhistory_1 = history_1_next_19;\nhistory_2 = history_2_next_20;\nhistory_3 = history_3_next_21;\nhistory_4 = history_4_next_22;",
