					"rnbo_classname" : "gen~",
					"rnbo_extra_attributes" : 					{
						"exposeparams" : 0,
						"gencode" : "Delay delay_1(22050);\nDelay delay_2(10584);\nHistory history_3(0);\ntap_4 = delay_1.read(22050);\nmul_5 = history_3 * in4;\ndiv_6 = SAMPLERATE / 1000.;\nint_7 = int(120);\nmstosamps_8 = mstosamps(int_7);\ndiv_9 = int_7 / 1000;\nint_10 = int(2);\ndiv_11 = in2 / 12.;\npow_12 = pow(int_10, div_11);\nsub_13 = pow_12 - 1.;\ndiv_14 = sub_13 / div_9;\nmul_15 = div_14 * -1.;\nphasor_16 = phasor(mul_15, 0);\nmul_17 = phasor_16 * mstosamps_8;\nadd_18 = mul_17 + div_6;\nmul_19 = phasor_16 * 0.5;\nadd_20 = mul_19 + 0.75;\ncycle_21, cycleindex_22 = cycle(add_20, index=\"phase\");\nadd_23 = phasor_16 + 0.5;\nmod_24 = add_23 % 1.;\nmul_25 = mod_24 * mstosamps_8;\nadd_26 = mul_25 + div_6;\ntap_27 = delay_2.read(add_18);\ntap_28 = delay_2.read(add_26);\nmul_29 = tap_27 * cycle_21;\nmul_30 = mod_24 * 0.5;\nadd_31 = mul_30 + 0.75;\ncycle_32, cycleindex_33 = cycle(add_31, index=\"phase\");\nmul_34 = tap_28 * cycle_32;\nadd_35 = mul_29 + mul_34;\nmix_36 = mix(in1, add_35, in3);\nout1 = mix_36;\nhistory_3_next_37 = fixdenorm(tap_4);\ndelay_1.write(mix_36);\nhistory_3 = history_3_next_37;\ndelay_2.write(in1 + mul_5);",
						"geninlets" : 4,
						"genoutlets" : 1
					}
,
